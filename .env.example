# Local PostgreSQL settings.
POSTGRES_DB=gdgc_dev
POSTGRES_USER=gdgc
POSTGRES_PASSWORD=gdgc_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://gdgc:gdgc_dev@127.0.0.1:5433/gdgc_dev

# Set a secret with at least 32 characters.
# Run: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Set these values to test GitHub sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Set these values to test Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
